# JubileeSearch engine — environment.
#
# The engine reads this file via `node --env-file-if-exists=.env`. Everything
# that changes ranking behaviour lives in the `ranking_config` table instead, so
# that it can be tuned at runtime without a deploy (spec 13.6, admin screen 9).
# What is here is deployment facts: where things are, and who we are to them.

# ---------------------------------------------------------------------------
# Database. Decision D1 recommends its own instance rather than sharing the
# InspireManna database with Jubilee Analytics: ingest write load and HNSW index
# memory contend badly with analytics ingest. Same technology, separate server.
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=jubileesearch
PGUSER=jubileesearch
PGPASSWORD=
PGPOOL_MAX=10
PGSTATEMENT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# API. Port 4038 is what ops/config/cloudflare-config.yml already maps
# api.jubileesearch.com to.
# ---------------------------------------------------------------------------
PORT=4038
NODE_ENV=production
LOG_LEVEL=info

# Comma-separated registered Jubilee hosts allowed to call the API from a
# browser (spec 14, embeddable widget). Subdomains of a listed host are allowed;
# anything else gets no CORS headers at all.
CORS_ALLOWLIST=jubileesearch.com,jubileeverse.com,kjubilee.com,jubileeinspire.com

# ---------------------------------------------------------------------------
# Jubilee Inference API — the sole provider of embeddings, reranking and safety
# classification (spec 16). JubileeSearch runs no models of its own.
#
# Decision D8: whether the RTX PRO 6000 is cleared to take ingest-time embedding
# batches alongside persona traffic. Until it is answered, run the backfill in an
# off-peak window from the systemd timer, not continuously.
#
# LEAVING INFERENCE_API_URL EMPTY IS NOT A NO-OP. Nothing errors, but no chunk
# is ever embedded and every search runs on its lexical arm alone -- so a query
# that shares no words with a page returns nothing at all, which looks exactly
# like a broken search engine. /api/v1/health names the mode it is in:
#
#     "inference": { "configured": false, "search_mode": "lexical-only" }
#
# Check a URL against the contract the engine depends on before trusting it:
#
#     npm run inference:check
#
# It verifies the embedding dimension is 1024 -- chunks.embedding is
# halfvec(1024), so a 768- or 1536-dimension model does not degrade, it fails
# every insert -- that batching is honoured, that the vectors are not all the
# same, and that gate 3 classification answers (without it, P1 default deny
# leaves every crawled page in T0 and Zone B stays empty).
# ---------------------------------------------------------------------------
INFERENCE_API_URL=
INFERENCE_API_KEY=
EMBEDDING_MODEL=bge-m3@v1
RERANK_MODEL=bge-reranker-v2-m3@v1
SAFETY_MODEL=
EMBED_BATCH=48
EMBED_LRU_MAX=10000

# ---------------------------------------------------------------------------
# Ecosystem (spec 16). Each of these degrades to "that feature is off" rather
# than to an error: no JSV means no scripture card, no Analytics means no
# engagement signal, no SSO means no admin access.
# ---------------------------------------------------------------------------
JSV_API_URL=
ANALYTICS_API_URL=

# Jubilee SSO. Admin endpoints require a Jubilee ID with the `search_admin`
# right; there is never a separate password system (spec 14).
#
# The engine verifies a bearer token one of three ways, in this order:
#
#   SSO_INTROSPECT_URL  RFC 7662 introspection. Authoritative -- it answers
#                       "is this token valid right now", which a signature
#                       check cannot, so a revoked token is refused at once.
#                       Costs a round trip per token (cached 60s).
#   SSO_JWKS_URL        Local JWT verification against the published keys. No
#                       round trip, but a revoked token stays usable until it
#                       expires. Used only when there is no introspection
#                       endpoint.
#   SSO_BASE            The Jubilee authority, which is NEITHER of the above.
#                       It publishes no JWKS and no RFC 7662 endpoint, and its
#                       tokens are base64url(JSON).HMAC -- two segments, no JWT
#                       header, no kid -- so JWKS cannot verify them even in
#                       principle. Instead GET <SSO_BASE>/api/auth/me is asked
#                       with the caller's own bearer, which is introspection in
#                       all but name: live, so revocation takes effect at once.
#                       This is the setting a Jubilee deployment actually uses.
#
# Set SSO_ISSUER_URL and SSO_AUDIENCE alongside JWKS so issuer and audience are
# checked too: a token minted for another Jubilee property is a perfectly valid
# token, just not one for this service.
SSO_INTROSPECT_URL=
SSO_JWKS_URL=
SSO_ISSUER_URL=
SSO_AUDIENCE=jubileesearch
SSO_BASE=https://sso.jubileeinspire.com
SSO_CLIENT_ID=jubileesearch
SSO_CLIENT_SECRET=

# Who may administer THIS site. Comma-separated; a Jubilee ID (uuid) or an email
# matches, and email matching ignores case.
#
# Local, and it has to be: the authority has no rights, roles or scopes of any
# kind, so no token it issues can carry `search_admin`. Authentication stays
# remote -- only the authority says who someone is, this site still has no
# password, and revoking a Jubilee ID revokes access here immediately. Only the
# smaller question of who administers JubileeSearch is answered here. An admin
# listed here is an admin nowhere else, and adding one is a deploy.
#
# Empty means nobody is an administrator, which is the safe default: with no
# entries the admin routes refuse every caller, authenticated or not.
SEARCH_ADMINS=gaberial.ungureanu@outlook.com
SEARCH_VIEWERS=

# Development only, and inert whenever NODE_ENV=production. With no
# SSO_INTROSPECT_URL configured and this set, every bearer token is treated as
# search_admin. Never set it on a deployed host.
ALLOW_INSECURE_ADMIN=false

# ---------------------------------------------------------------------------
# Crawler identity. The user agent string is fixed by spec 9.4 and must not be
# changed; the page it points at is bot.html at the repository root and needs an
# nginx rewrite from /bot.
#
# BOT_CONTACT_EMAIL is decision D7 and is needed before the first external
# crawl. It appears on the bot page and receives removal requests, which are
# answered within five business days (spec 17, Legal).
# ---------------------------------------------------------------------------
BOT_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Content feed (docs/SEARCH-FEED.md)
#
# The service token the publisher's /api/search-feed requires. Server-to-server
# only; it is never sent to a browser and never stored in the database, because
# the domains table is readable through the admin API.
#
# The publisher's endpoint FAILS CLOSED: with its own copy unset it answers 503
# and serves nothing, so a forgotten variable cannot turn an internal content
# export into a public one.
# ---------------------------------------------------------------------------
SEARCH_FEED_TOKEN=

# Only if the feed sits behind Cloudflare Access (see the service-token guide in
# the jubileeverse and kJubilee repos). Unset means the feed is reached directly.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

FEED_PAGE_SIZE=100
FEED_TIMEOUT_MS=30000

# Gates the internal endpoints the web tier calls server-to-server
# (/api/v1/users/lookup, /api/v1/password-resets/*). Unset = refuse everything.
# Must equal INTERNAL_API_SECRET in web/.env.local.
INTERNAL_API_SECRET=
