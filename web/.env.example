# JubileeSearch web — environment.
#
# Copy to .env.local (gitignored) and fill in. Nothing here is required to run
# the site: with no SSO configured, search works exactly as it does now and the
# sign-in page says what is missing instead of offering a dead button.

# ---------------------------------------------------------------------------
# The engine
# ---------------------------------------------------------------------------
ENGINE_API_URL=http://127.0.0.1:4038
ENGINE_TIMEOUT_MS=5000
SITE_URL=http://localhost:3038

# Decision D7. Until it is set, /bot says so rather than showing a fake address.
BOT_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Jubilee ID (SSO) authority — the email-first door.
#
# JubileeSearch calls the authority's SERVICE API from the server, the same way
# kJubilee.com does (its lib/sso.js is what web/lib/sso.ts was ported from). A
# reader never leaves the site: the door looks the email up, posts the password
# here, and this server verifies it at the authority.
#
# This replaced an OAuth authorization-code + PKCE redirect flow. SSO_REDIRECT_URI,
# SSO_AUTHORIZATION_URL, SSO_TOKEN_URL, SSO_USERINFO_URL and SSO_SCOPES belonged
# to that flow and are gone; delete them from any .env that still carries them.
#
# The secret is what makes the door work at all. Without it every screen answers
# "Sign-in is temporarily unavailable", which is honest but not useful.
# ---------------------------------------------------------------------------
SSO_BASE=
SSO_CLIENT_ID=jubileesearch
SSO_CLIENT_SECRET=
# The site key sent with login/register, so the authority can record which
# property an identity was used on.
SSO_SITE=jubileesearch
SSO_TIMEOUT_MS=10000

# Signing out of search ends the 90-day family session at the authority too,
# which signs the reader out of every other Jubilee property. Off by default:
# leaving a search page should not close someone's Bible study in another tab.
SSO_END_SESSION_ON_SIGNOUT=false

# ---------------------------------------------------------------------------
# Session
#
# Required before anyone can sign in. It encrypts the cookie that carries the
# access token, so a weak or shared value is the same as no encryption. There is
# deliberately no default and no development fallback.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=
