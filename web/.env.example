# JubileeSearch web — environment.
#
# Copy to .env.local (gitignored) and fill in. Nothing here is required to run
# the site: with no SSO configured, search works exactly as it does now and the
# sign-in page says what is missing instead of offering a dead button.

# ---------------------------------------------------------------------------
# The engine
# ---------------------------------------------------------------------------
ENGINE_API_URL=http://127.0.0.1:4038
ENGINE_TIMEOUT_MS=5000
SITE_URL=http://localhost:3038

# Decision D7. Until it is set, /bot says so rather than showing a fake address.
BOT_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Jubilee ID (SSO) authority — the email-first door.
#
# JubileeSearch calls the authority's SERVICE API from the server, the same way
# kJubilee.com does (its lib/sso.js is what web/lib/sso.ts was ported from). A
# reader never leaves the site: the door looks the email up, posts the password
# here, and this server verifies it at the authority.
#
# This replaced an OAuth authorization-code + PKCE redirect flow. SSO_REDIRECT_URI,
# SSO_AUTHORIZATION_URL, SSO_TOKEN_URL, SSO_USERINFO_URL and SSO_SCOPES belonged
# to that flow and are gone; delete them from any .env that still carries them.
#
# The secret is what makes the door work at all. Without it every screen answers
# "Sign-in is temporarily unavailable", which is honest but not useful.
# ---------------------------------------------------------------------------
SSO_BASE=
SSO_CLIENT_ID=jubileesearch
SSO_CLIENT_SECRET=
# The site key sent with login/register, so the authority can record which
# property an identity was used on.
SSO_SITE=jubileesearch
SSO_TIMEOUT_MS=10000

# Signing out of search ends the 90-day family session at the authority too,
# which signs the reader out of every other Jubilee property. Off by default:
# leaving a search page should not close someone's Bible study in another tab.
SSO_END_SESSION_ON_SIGNOUT=false

# The authority's access token lasts about fifteen minutes and it issues no
# refresh token. web/proxy.ts renews it from the 90-day family session
# (POST /api/auth/session/exchange) when it is within SESSION_RENEW_WINDOW_S of
# expiring, and waits at most SSO_RENEW_TIMEOUT_MS for the answer because that
# happens inside a page request. Widening the window forces the exchange more
# often, which is how to watch it work against the real authority.
SESSION_RENEW_WINDOW_S=300
SSO_RENEW_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Session
#
# Required before anyone can sign in. It encrypts the cookie that carries the
# access token, so a weak or shared value is the same as no encryption. There is
# deliberately no default and no development fallback.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=

# Cookies and TLS. Every auth cookie is Secure whenever NODE_ENV=production.
# Production is reached over https (Cloudflare -> nginx -> :3038), so they are
# stored; opening the origin directly over http://<host>:3038 makes the browser
# drop them all silently, and sign-in appears to do nothing. That is a
# deployment prerequisite, not a switch: there is deliberately no
# COOKIE_SECURE=false, because it would make the access-token cookie sniffable
# for the sake of a debugging convenience.

# ---------------------------------------------------------------------------
# Door throttling. Ported from kJubilee (lib/api.js `ssoAuthLimiter`) and shared
# by /api/sso/login, /api/sso/signup/lookup and /api/sso/signup/register: one
# budget per client IP across all three, because they are three ways of asking
# the same authority the same question.
#
# The defaults are kJubilee's — 30 attempts per 15 minutes. Raise the max only
# with a reason: this is what stands between the door and password guessing, and
# the lookup route answering "does this address have a Jubilee ID" is an
# enumeration oracle without it.
#
# PER PROCESS. A multi-instance deploy multiplies the budget by the number of
# instances; a shared store is the fix and neither site has one yet.
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — the human check on the door's first screen
# (/api/sso/signup/lookup). Ported from kJubilee's lib/turnstile.js.
#
# Enforcement switches itself ON as soon as a secret is present. With no secret
# the widget is not rendered and the check is skipped entirely, so a deployment
# that has not been given keys behaves exactly as it did before this existed.
#
# ⚠ THE WIDGET ONLY PAINTS ON A HOSTNAME IN THE SITE KEY'S CLOUDFLARE ALLOWLIST.
# If jubileesearch.com — and localhost, for development — are not on it, no
# token is ever produced, the server refuses every lookup, and NOBODY CAN SIGN
# IN. Set TURNSTILE_ENFORCE=false to keep the widget visible without gating on
# it; that is the escape hatch for a box in that state.
#
# The site key is public — it is handed to the browser. THE SECRET IS NOT:
# put it in .env.local, which is git-ignored, and never in this file.
# ---------------------------------------------------------------------------
# ── Outbound email (lib/email.ts) ─────────────────────────────────────────
# Used by the password-reset flow (/forgot-password). Leave MAILGUN_API_KEY
# empty and the dev transport LOGS the message instead of sending it, so every
# code path still runs on a box that cannot send. EMAIL_FROM must stay on the
# Mailgun sending domain or DMARC-aligned receivers throw the message away.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=jubileesearch.com
MAILGUN_API_BASE=https://api.mailgun.net
EMAIL_FROM=JubileeSearch <noreply@jubileesearch.com>
# EMAIL_TEST_MODE=true   # Mailgun validates and logs, delivers to nobody
# The public origin the reset link points at. Falls back to SITE_URL.
PUBLIC_SITE_URL=https://jubileesearch.com
# Where the mail client loads the logo from. Defaults to the public site so a
# message sent from a development box does not point its image at localhost.
# EMAIL_ASSET_URL=https://jubileesearch.com

# Shared secret with the engine (engine/.env INTERNAL_API_SECRET). The reset
# flow stores its one-time tokens through the engine's internal endpoints
# (/api/v1/password-resets/*), which refuse everything while this is unset, so
# /forgot-password answers 503 until both sides carry the same value.
INTERNAL_API_SECRET=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENFORCE=false
TURNSTILE_TIMEOUT_MS=8000
